    "src/App.jsx:73-106"
  ],
  "nodeFields": {
    "section": "section id",
    "required": "must appear",
    "repeatable": "may appear more than once (see maxCount)",
    "maxCount": "optional cap for repeatable nodes",
    "group": "nodes sharing a group form an order-free pool between fixed prefix and suffix",
    "condition": "data state under which an optional node appears",
    "nestedIn": "node is rendered as children of another node but listed flat",
    "note": "free text, not enforced"
  },
  "instanceFields": {
    "routes": "concrete route patterns that render exactly this sequence",
    "sequence": "the real, expanded section sequence with `tone` (white|tinted|dark background, verified from source classes) and, for accordion-showcase, `flip` (alternate side)",
